-- SANGUINE Z-3 FPS DROP (integrado)
-- ============================================================
local DROP_TO_FPS = 20
local LAG_DURATION = 0.43
local SANGUINE_ANIMATION_ID = "rbxassetid://15682737850" -- Foul Strike animation id

local SanguineEnabled = false
local lagBusy = false

local function dropFPS()
    if lagBusy or not SanguineEnabled then return end
    lagBusy = true
    local stop = tick() + LAG_DURATION
    local interval = 1 / DROP_TO_FPS
    local con
    con = RunService.RenderStepped:Connect(function()
        if tick() > stop then
            if con then con:Disconnect() end
            return
        end
        local now = tick()
        while tick() - now < interval do end
    end)
    task.wait(0.10)
    lagBusy = false
end

-- Watcher de animación Sanguine
local function connectSanguineWatcher()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid")
    if hum:FindFirstChild("__SACRED_SANGUINE") then
        hum:FindFirstChild("__SACRED_SANGUINE"):Destroy()
    end
    local flag = Instance.new("BoolValue")
    flag.Name = "__SACRED_SANGUINE"
    flag.Parent = hum
    hum.AnimationPlayed:Connect(function(anim)
        if SanguineEnabled and tostring(anim.Animation.AnimationId):find(SANGUINE_ANIMATION_ID) then
            dropFPS()
        end
    end)
end

player.CharacterAdded:Connect(function()
    task.wait(1)
    connectSanguineWatcher()
end)
if player.Character then connectSanguineWatcher() end

